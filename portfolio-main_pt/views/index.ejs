<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="hero">
    <div class="container hero-inner">
        <div class="hero-text">
            <p class="eyebrow"><%= t('hero.eyebrow') %></p>
            <h1><%= t('hero.headline') %></h1>
            <p class="hero-summary"><%= t('hero.summary') %></p>
            <div class="cta-row">
                <a class="btn btn-primary" href="/projects"><%= t('hero.projects') %></a>
                <% if (hasResume) { %><a class="btn" href="/downloads/resume.pdf" download><%= t('hero.resume') %></a><% } %>
                <% if (contactEmail) { %><a class="btn" href="mailto:<%= contactEmail %>"><%= t('hero.email') %></a><% } %>
                <a class="btn" href="<%= site.linkedin %>" target="_blank" rel="noopener noreferrer">LinkedIn</a>
                <a class="btn" href="<%= site.github %>" target="_blank" rel="noopener noreferrer">GitHub</a>
            </div>
        </div>
        <div class="avatar" data-avatar data-autoplay-delay="7000" data-hint-blocked="<%= t('avatar.hintBlocked') %>">
            <button type="button" class="avatar-btn" aria-pressed="false"
                    data-label-play="<%= t('avatar.play') %>" data-label-pause="<%= t('avatar.pause') %>"
                    aria-label="<%= t('avatar.play') %>">
                <video class="avatar-video" src="<%= asset('/video/intro-' + lang + '.mp4') %>" poster="<%= asset('/video/intro-' + lang + '.jpg') %>"
                       width="624" height="840" preload="auto" playsinline></video>
                <span class="avatar-icon" aria-hidden="true">
                    <svg class="icon-play" viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                    <svg class="icon-pause" viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M6 5h4v14H6zm8 0h4v14h-4z"/></svg>
                </span>
            </button>
            <p class="avatar-hint"><%= t('avatar.hint') %></p>
            <details class="avatar-transcript">
                <summary><%= t('avatar.transcript') %></summary>
                <p><%= t('avatar.script') %></p>
                <p class="muted avatar-note"><%= t('avatar.note') %></p>
            </details>
        </div>
    </div>
</section>

<div class="container">
    <section class="section" aria-labelledby="highlights-title">
        <h2 id="highlights-title" class="visually-hidden"><%= t('sections.highlights') %></h2>
        <ul class="stats">
            <% highlights.forEach(function (h) { %>
            <li class="stat reveal">
                <span class="stat-value"><%= h.value %></span>
                <span class="stat-label"><%= loc(h.label) %></span>
            </li>
            <% }) %>
        </ul>
    </section>

    <section class="section" aria-labelledby="experience-title">
        <h2 id="experience-title"><%= t('sections.experience') %></h2>
        <div class="grid grid-3">
            <% experience.forEach(function (job) { %>
            <article class="card reveal">
                <header class="card-head">
                    <% if (job.logo) { %>
                    <% var logoImg = '<img class="logo" src="' + job.logo + '" alt="' + job.org + '" width="48" height="48" loading="lazy">'; %>
                    <% if (job.url) { %>
                    <a href="<%= job.url %>" target="_blank" rel="noopener noreferrer"><%- logoImg %></a>
                    <% } else { %>
                    <%- logoImg %>
                    <% } %>
                    <% } else { %>
                    <span class="logo logo-fallback" aria-hidden="true"><%= job.org.split(' ').map(function (w) { return w[0]; }).join('').slice(0, 2) %></span>
                    <% } %>
                    <div>
                        <h3><%= loc(job.role) %></h3>
                        <p class="muted"><%= job.org %> · <%= loc(job.period) %></p>
                    </div>
                </header>
                <ul class="bullets">
                    <% loc(job.bullets).forEach(function (b) { %><li><%= b %></li><% }) %>
                </ul>
            </article>
            <% }) %>
        </div>
    </section>

    <section class="section" aria-labelledby="skills-title">
        <h2 id="skills-title"><%= t('sections.skills') %></h2>
        <div class="grid grid-2">
            <% skills.forEach(function (group) { %>
            <article class="card reveal">
                <h3><%= loc(group.title) %></h3>
                <ul class="tags">
                    <% group.items.forEach(function (item) { %><li class="tag"><%= item %></li><% }) %>
                </ul>
            </article>
            <% }) %>
        </div>
    </section>

    <section class="section" aria-labelledby="education-title">
        <h2 id="education-title"><%= t('sections.education') %></h2>
        <div class="grid grid-2">
            <% education.forEach(function (ed) { %>
            <article class="card reveal">
                <header class="card-head">
                    <a href="<%= ed.url %>" target="_blank" rel="noopener noreferrer">
                        <img class="logo" src="<%= ed.logo %>" alt="<%= ed.school %>" width="48" height="48" loading="lazy">
                    </a>
                    <div>
                        <h3><%= ed.school %></h3>
                        <p class="muted"><%= ed.date %> · <%= ed.place %></p>
                    </div>
                </header>
                <p><strong><%= loc(ed.degree) %></strong></p>
            </article>
            <% }) %>
        </div>
    </section>

    <section class="section" aria-labelledby="languages-title">
        <h2 id="languages-title"><%= t('sections.languages') %></h2>
        <ul class="languages">
            <% languages.forEach(function (l) { %>
            <li class="card lang-card reveal">
                <img class="flag" src="<%= l.flag %>" alt="<%= loc(l.alt) %>" width="48" height="32" loading="lazy">
                <span><strong><%= loc(l.name) %></strong> — <%= loc(l.level) %></span>
            </li>
            <% }) %>
        </ul>
    </section>

    <section class="section contact" id="contact" aria-labelledby="contact-title">
        <h2 id="contact-title"><%= t('sections.contact') %></h2>
        <p><%= t('contact.text') %></p>
        <div class="cta-row">
            <% if (contactEmail) { %><a class="btn btn-primary" href="mailto:<%= contactEmail %>"><%= t('hero.email') %></a><% } %>
            <a class="btn <%= contactEmail ? '' : 'btn-primary' %>" href="<%= site.linkedin %>" target="_blank" rel="noopener noreferrer"><%= t('contact.linkedin') %></a>
            <a class="btn" href="<%= site.github %>" target="_blank" rel="noopener noreferrer"><%= t('contact.github') %></a>
        </div>
    </section>
</div>

<%- include('partials/footer') %>
