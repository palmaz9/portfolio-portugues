<%- include('partials/head') %>
<%- include('partials/header') %>

<div class="container">
    <section class="section">
        <h1 class="page-title"><%= t('projects.heading') %></h1>
        <p class="muted"><%= t('projects.intro') %></p>

        <div class="projects">
            <% projects.forEach(function (p) { %>
            <article class="card project reveal" id="<%= p.id %>">
                <img class="project-img" src="<%= p.image %>" alt="<%= loc(p.alt) %>" width="640" height="360" loading="lazy">
                <div class="project-body">
                    <h2><%= loc(p.title) %></h2>
                    <dl class="case">
                        <dt><%= t('projects.problem') %></dt>
                        <dd><%= loc(p.problem) %></dd>
                        <dt><%= t('projects.approach') %></dt>
                        <dd><%= loc(p.approach) %></dd>
                        <dt><%= t('projects.result') %></dt>
                        <dd><%= loc(p.result) %></dd>
                    </dl>
                    <ul class="tags" aria-label="<%= t('projects.stack') %>">
                        <% p.stack.forEach(function (s) { %><li class="tag"><%= s %></li><% }) %>
                    </ul>
                    <% if (p.link) { %>
                    <a class="btn" href="<%= p.link.href %>"
                       <% if (p.link.download) { %>download="<%= p.link.download %>"<% } else { %>target="_blank" rel="noopener noreferrer"<% } %>><%= loc(p.link.label) %></a>
                    <% } %>
                </div>
            </article>
            <% }) %>
        </div>
    </section>
</div>

<%- include('partials/footer') %>
