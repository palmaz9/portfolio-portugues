<header class="site-header">
    <div class="container header-inner">
        <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">&lt;/&gt;</span> Lucas Palma</a>
        <nav aria-label="<%= t('nav.label') %>">
            <ul class="nav-list">
                <li><a href="/" <%- path === '/' ? 'aria-current="page"' : '' %>><%= t('nav.home') %></a></li>
                <li><a href="/projects" <%- path === '/projects' ? 'aria-current="page"' : '' %>><%= t('nav.projects') %></a></li>
                <li><a href="/certifications" <%- path === '/certifications' ? 'aria-current="page"' : '' %>><%= t('nav.credentials') %></a></li>
            </ul>
        </nav>
        <div class="header-tools">
            <a class="lang-toggle" href="?lang=<%= otherLang %>" hreflang="<%= otherLang %>" lang="<%= otherLang %>" aria-label="<%= t('nav.language') %>: <%= otherLang.toUpperCase() %>">
                <span class="<%= lang === 'en' ? 'is-active' : '' %>">EN</span> | <span class="<%= lang === 'pt' ? 'is-active' : '' %>">PT</span>
            </a>
            <button type="button" class="theme-toggle" id="theme-toggle" aria-label="<%= t('nav.theme') %>">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            </button>
        </div>
    </div>
</header>
<main id="main">
